        ActionStartBtn.TextColor3 = C.red
        pcall(function()
            TweenService:Create(ActionStartBtn, TweenInfo.new(0.15), {BackgroundColor3 = C.redBg}):Play()
        end)
        for _, ch in ipairs(ActionStartBtn:GetChildren()) do
            if ch:IsA("UIStroke") then
                pcall(function()
                    TweenService:Create(ch, TweenInfo.new(0.15), {Color = C.red, Transparency = 0.35}):Play()
                end)
            end
        end
    else
        pcall(function()
            TweenService:Create(StartBtn, TweenInfo.new(0.15), {BackgroundColor3 = C.accentDk}):Play()
        end)
        StartBtn.Text = "START"
        StartBtn.TextColor3 = C.accent
