-- GAME LOGIC
-- ═══════════════════════════════
local function isOurGui(inst)
    local p = inst
    for _ = 1, 10 do
        if not p then break end
        if p.Name == "VailUI" or p.Name == "VailSettingsUI" then return true end
        p = p.Parent
    end
    return false
end

local function isVisibleChain(inst)
    local c = inst
    while c do
        if c:IsA("GuiObject") and not c.Visible then return false end
        if c:IsA("ScreenGui") then return c.Enabled end
        c = c.Parent
    end
    return true
end

local function findCodeBox()
    local pg = playerGui
    if not pg then return nil end
    local boxes = {}
    for _, gui in ipairs(pg:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and not isOurGui(gui) then
            for _, d in ipairs(gui:GetDescendants()) do
                if d:IsA("TextBox") and not isOurGui(d) then
                    boxes[#boxes + 1] = d
                end
            end
        end
    end
    for _, box in ipairs(boxes) do
        if isVisibleChain(box) then
            local n = box.Name:lower()
            local pn = (box.Parent and box.Parent.Name or ""):lower()
            if n:find("code") or pn:find("code") or n:find("redeem") or pn:find("redeem")
            or n:find("input") or n:find("enter") then
                return box
            end
        end
    end
    for _, box in ipairs(boxes) do
        if isVisibleChain(box) then return box end
    end
    return nil
end

local function findSubmitButton(box)
    local pg = playerGui
    if not pg then return nil end
    local names = {"submit","redeem","claim","confirm","enter","send","apply","ok","use","go","check"}
    if box then
        local p = box.Parent
        for _ = 1, 6 do
            if not p then break end
            for _, d in ipairs(p:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOurGui(d) and d ~= box then
                    local n = d.Name:lower()
                    local txt = ""
                    pcall(function() txt = d.Text:lower() end)
                    for _, sn in ipairs(names) do
                        if (n:find(sn) or txt:find(sn)) and isVisibleChain(d) then return d end
                    end
                end
            end
            p = p.Parent
        end
    end
    local btns = {}
    for _, gui in ipairs(pg:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and not isOurGui(gui) then
            for _, d in ipairs(gui:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOurGui(d) then
                    local n = d.Name:lower()
                    local txt = ""
                    pcall(function() txt = d.Text:lower() end)
                    for _, sn in ipairs(names) do
                        if (n:find(sn) or txt:find(sn)) and isVisibleChain(d) then
                            table.insert(btns, d)
                            break
                        end
                    end
                end
            end
        end
    end
    return btns[1]
end

local function clickButton(btn)
    if not btn then return false end
    local ok = false
    local methods = {
        function() btn.MouseButton1Click:Fire() end,
        function() btn.Activated:Fire() end,
    }
    if firesignal_fn then
        table.insert(methods, function() firesignal_fn(btn.MouseButton1Click) end)
        table.insert(methods, function() firesignal_fn(btn.Activated) end)
    end
    if getconns_fn then
        table.insert(methods, function()
            local s, c = pcall(getconns_fn, btn.MouseButton1Click)
            if s and type(c) == "table" then
                for _, x in ipairs(c) do pcall(function() x:Fire() end) end
            end
            local s2, c2 = pcall(getconns_fn, btn.Activated)
            if s2 and type(c2) == "table" then
                for _, x in ipairs(c2) do pcall(function() x:Fire() end) end
            end
        end)
    end
    if fireclick_fn then
        table.insert(methods, function() fireclick_fn(btn) end)
    end
    for _, fn in ipairs(methods) do
        ok = ok or pcall(fn)
    end
    return ok
end

local function fireBoxFocusLost(box)
    if not box then return false end
    local fired = false
    if firesignal_fn then
        fired = fired or pcall(firesignal_fn, box.FocusLost, true)
    end
    if getconns_fn then
        local s, c = pcall(getconns_fn, box.FocusLost)
        if s and type(c) == "table" then
            for _, x in ipairs(c) do
                local fn
                pcall(function() fn = x.Function end)
                if fn and getupvalues_fn and setupvalue_fn then
                    local u, ups = pcall(getupvalues_fn, fn)
                    if u and type(ups) == "table" then
                        for i, v in pairs(ups) do
                            if type(v) == "boolean" and v == true then
                                pcall(setupvalue_fn, fn, i, false)
                            end
                        end
                    end
                end
                fired = fired or pcall(function()
                    if x.Enabled ~= false then x:Fire(true) end
                end)
            end
        end
    end
    return fired
end

local function processCode(code)
    if not code or code == "" then return end
    runtime.lastCode = code
    if runtime.autoCopy then
        pcall(function()
            if setclipboard then setclipboard(code)
            elseif toclipboard then toclipboard(code) end
        end)
    end
    if runtime.autoType then
        local box = findCodeBox()
        if not box then
            consoleLog('<font color="#e6505f">No code box</font>')
            return
        end
        pcall(function() box.Text = code end)
        fireBoxFocusLost(box)
        consoleLog('<font color="#9ba5ff">Typed: ' .. code .. '</font>')
        if runtime.autoSubmit then
            task.wait(0.15)
            local btn = findSubmitButton(box)
            if btn then
                clickButton(btn)
                consoleLog('<font color="#55d282">Submitted: ' .. code .. '</font>')
            else
                consoleLog('<font color="#e6505f">No submit button</font>')
            end
        end
    elseif runtime.autoSubmit then
        local box = findCodeBox()
        local btn = box and findSubmitButton(box)
        if btn then
            clickButton(btn)
            consoleLog('<font color="#55d282">Submitted: ' .. code .. '</font>')
        else
            consoleLog('<font color="#e6505f">No submit found</font>')
        end
    end
    if runtime.autoCopy then
        consoleLog('<font color="#55d282">Copied: ' .. code .. '</font>')
    end
end

local function resolveNotifyRemote()
    if runtime.notifyRemote and runtime.notifyRemote.Parent then return runtime.notifyRemote end
    local cands = {}
    pcall(function()
        for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
            if d:IsA("RemoteEvent") then
                local n = d.Name:lower()
                if n:find("notif") or n:find("announce") or n:find("broadcast")
                or n:find("global") or n:find("message") or n:find("chat") then
                    table.insert(cands, d)
                end
            end
        end
    end)
    if #cands > 0 then
        runtime.notifyRemote = cands[1]
        return cands[1]
    end
    return nil
end

local function stripRich(t)
    return type(t) == "string" and (t:gsub("<[^>]->", "")) or tostring(t)
end

local function tokenize(t)
    local w = {}
    for word in t:gmatch("[%w_]+") do w[#w + 1] = word end
    return w
end

local function onAnnouncement(...)
    if not runtime.enabled then return end
    local text = stripRich(tostring((...) or "")):match("^%s*(.-)%s*$") or ""
    if text == "" or text:find("%s") then return end
    if runtime.seen[text] then return end
    runtime.seen[text] = true
    task.delay(1.25, function() runtime.seen[text] = nil end)
    for _, w in ipairs(tokenize(text)) do
        table.insert(runtime.capturedParts, w)
    end
    local cnt = #runtime.capturedParts
    local joined = table.concat(runtime.capturedParts)
    consoleLog(string.format(
        '<font color="#9ba5ff">%d/%d</font> <font color="#6b7099">[%s]</font>',
        cnt, runtime.submitAfter, joined
    ))
    if cnt >= runtime.submitAfter then
        runtime.lastCode = joined
        runtime.capturedParts = {}
        consoleLog('<font color="#9ba5ff">Code: ' .. joined .. '</font>')
        processCode(joined)
    end
end

local function startNotifListener()
    if runtime.notifConn then return end
    local r = resolveNotifyRemote()
    if r then
        runtime.notifConn = r.OnClientEvent:Connect(function(...)
            pcall(onAnnouncement, ...)
        end)
    end
end

local function stopNotifListener()
    if runtime.notifConn then
        disconnect(runtime.notifConn)
        runtime.notifConn = nil
    end
end

local function toggleEnabled()
    runtime.enabled = not runtime.enabled
    syncStartVisual()
    if runtime.enabled then
        startNotifListener()
        consoleLog('<font color="#55d282">Listening for codes</font>')
    else
        stopNotifListener()
        consoleLog('<font color="#e6505f">Stopped</font>')
    end
end

