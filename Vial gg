-- METEORS
-- ═══════════════════════════════
task.spawn(function()
    while runtime.alive and Gui and Gui.Parent do
        if runtime.particlesEnabled then
            local col = C.mColors[math.random(1, #C.mColors)]
            local sx = math.random(-10, WIN_W + 10)
            local spd = 120 + math.random(60, 140)
            local drift = math.random(-12, 12)
            local w = math.random(1, 3)
            local len = math.random(20, 50)

            local m = new("Frame", {
                Size=UDim2.new(0, len, 0, w),
                Position=UDim2.new(0, sx, 0, -10),
                BackgroundColor3=col,
                BackgroundTransparency=0.25,
                BorderSizePixel=0,
                Rotation=18 + math.random(0, 8),
                ZIndex=2,
            }, MeteorLayer)
            corner(m, 2)

            local grad = Instance.new("UIGradient")
            grad.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0),
                NumberSequenceKeypoint.new(0.4, 0.3),
                NumberSequenceKeypoint.new(1, 1),
            })
            grad.Rotation = 180
            grad.Parent = m

            local life = 0
            local mc
            mc = RunService.Heartbeat:Connect(function(dt)
                if not m.Parent then
                    if mc then mc:Disconnect() end
                    return
                end
                life = life + dt
                local cp = m.Position
                local nx = cp.X.Offset + drift * dt
                local ny = cp.Y.Offset + spd * dt
                m.Position = UDim2.new(0, nx, 0, ny)
                m.BackgroundTransparency = 0.25 + math.clamp(life * 0.35, 0, 0.75)
                if ny > WIN_H + 20 then
                    m:Destroy()
                    if mc then mc:Disconnect() end
                end
            end)
        end
        task.wait(0.35 + math.random() * 0.5)
    end
end)

