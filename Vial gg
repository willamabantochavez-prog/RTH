local function toggleEnabled()
    runtime.enabled = not runtime.enabled
    syncStartVisual()
    if runtime.enabled then
        startNotifListener()
        consoleLog("<font color='rgb(120,255,170)'>Started</font>")
    else
        stopNotifListener()
        consoleLog("<font color='rgb(255,95,115)'>Stopped</font>")
