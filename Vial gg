-- COMMUNITY PARTICLE SYSTEM
-- Uses popular Roblox community textures
-- ═══════════════════════════════
-- Popular community particle textures:
-- Soft glow, sparkles, magic, circle flare
local P_TEXTURES = {
    "rbxassetid://5833235272",  -- soft circle (community favorite)
    "rbxassetid://5833323391",  -- sparkle burst
    "rbxassetid://5857892330",  -- soft star
    "rbxassetid://5857851618",  -- circle flare
    "rbxassetid://6711256324",  -- soft dot glow
}

-- Each particle: a small ImageLabel that floats gently
local function spawnParticle()
    if not runtime.particlesEnabled then return end
    if not ParticleLayer or not ParticleLayer.Parent then return end

    local tex = P_TEXTURES[math.random(1, #P_TEXTURES)]
    local size = math.random(18, 48)
    local startX = math.random(-10, WIN_W - size + 10)
    local startY = WIN_H + 10

    local driftX = math.random(-25, 25) / 10  -- -2.5 to 2.5
    local riseSpeed = 40 + math.random(15, 55) -- gentle upward
    local fadeSpeed = 0.06 + math.random() * 0.08

    local hue = math.random(200, 260) / 360    -- blue-purple range
    local sat = 0.35 + math.random() * 0.35
    local val = 0.85 + math.random() * 0.15
    local tint = Color3.fromHSV(hue, sat, val)

    local p = new("ImageLabel", {
        Size=UDim2.new(0, size, 0, size),
        Position=UDim2.new(0, startX, 0, startY),
        BackgroundTransparency=1,
        Image=tex,
        ImageColor3=tint,
        ImageTransparency=0.4,
        Rotation=math.random(0, 360),
        ZIndex=2,
    }, ParticleLayer)

    local life = 0
    local rotSpeed = math.random(-30, 30)
    local wobbleAmp = math.random(5, 20) / 10
    local wobbleFreq = 0.5 + math.random() * 1.5
    local baseX = startX

    local mc
    mc = RunService.Heartbeat:Connect(function(dt)
        if not p.Parent then
            if mc then mc:Disconnect() end
            return
        end
        life = life + dt

        local newY = p.Position.Y.Offset - riseSpeed * dt
        local wobble = math.sin(life * wobbleFreq * math.pi * 2) * wobbleAmp
        local newX = baseX + driftX * life * 8 + wobble * 6

        p.Position = UDim2.new(0, newX, 0, newY)
        p.Rotation = p.Rotation + rotSpeed * dt

        -- fade in then fade out
        local progress = 1 - (newY / startY)
        if progress < 0.2 then
            -- fading in
            local fadeIn = progress / 0.2
            p.ImageTransparency = 0.4 + (1 - fadeIn) * 0.6
        else
            -- fading out
            local fadeOut = (progress - 0.2) / 0.8
            p.ImageTransparency = 0.4 + fadeOut * 0.6
        end

        if newY < -size - 20 then
            p:Destroy()
            if mc then mc:Disconnect() end
        end
    end)
end

-- particle spawner loop
task.spawn(function()
    while runtime.alive and Gui and Gui.Parent do
        if runtime.particlesEnabled then
            spawnParticle()
            -- spawn occasional clusters
            if math.random() > 0.65 then
                task.wait(0.05)
                spawnParticle()
            end
        end
        task.wait(0.3 + math.random() * 0.5)
    end
end)

