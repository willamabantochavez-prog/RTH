local meteorColors = {
    Color3.fromRGB(255,255,255),
    Color3.fromRGB(180,200,255),
    Color3.fromRGB(200,185,255),
    Color3.fromRGB(175,235,255),
}

task.spawn(function()
    while runtime.alive and Gui and Gui.Parent do
        if runtime.particlesEnabled then
            local col = meteorColors[math.random(1,#meteorColors)]
            local sx = math.random(-20, WIN_W + 20)
            local sy = -10
            local spd = 220 + math.random(80,200)
            local drift = math.random(-20,20)
            local w = math.random(2,4)
            local h = math.random(1,2)

            local m = new("Frame", {
                Size=UDim2.new(0,w,0,h),
                Position=UDim2.new(0,sx,0,sy),
                BackgroundColor3=col,
                BackgroundTransparency=0.15,
                BorderSizePixel=0,
                Rotation=20 + math.random(0,10),
                ZIndex=2,
            }, MeteorLayer)
            corner(m, 2)

            -- Trail glow
            local trail = new("Frame", {
                Size=UDim2.new(0,3,0,math.floor(w*3.5)),
                Position=UDim2.new(1,2,0.5,-math.floor(w*3.5)/2),
                BackgroundColor3=col,
                BackgroundTransparency=0.6,
                BorderSizePixel=0,
                ZIndex=1,
            }, m)
            corner(trail, 3)
            new("UIGradient", {
                Transparency=NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0.2),
                    NumberSequenceKeypoint.new(1, 1),
                }),
                Rotation=0,
            }, trail)

            -- Dot glow at head
            local glow = new("Frame", {
                Size=UDim2.new(0,w*3,0,w*3),
                Position=UDim2.new(0.5,-(w*3)/2,0.5,-(w*3)/2),
                BackgroundColor3=col,
                BackgroundTransparency=0.7,
                BorderSizePixel=0,
                ZIndex=3,
            }, m)
            corner(glow, UDim.new(1,0))

            local life = 0
            local mc
            mc = RunService.Heartbeat:Connect(function(dt)
                if not m.Parent then disconnect(mc); return end
                life = life + dt
                local cp = m.Position
                local nx = cp.X.Offset + drift * dt
                local ny = cp.Y.Offset + spd * dt
                m.Position = UDim2.new(0, nx, 0, ny)
                m.BackgroundTransparency = 0.15 + math.clamp(life*0.4, 0, 0.85)
                trail.BackgroundTransparency = 0.6 + math.clamp(life*0.3, 0, 0.4)
                glow.BackgroundTransparency = 0.7 + math.clamp(life*0.2, 0, 0.3)
                if ny > WIN_H + 20 or nx < -60 or nx > WIN_W + 60 then m:Destroy(); disconnect(mc) end
            end)
        end
        task.wait(0.2 + math.random() * 0.4)
    end
end)

