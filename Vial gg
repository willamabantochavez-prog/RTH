local function syncStartVisual()
    if runtime.enabled then
        pcall(function()
            TweenService:Create(StartBtn, TweenInfo.new(0.15), {BackgroundColor3 = C.redBg}):Play()
        end)
        StartBtn.Text = "STOP"
        StartBtn.TextColor3 = C.red
        for _, ch in ipairs(StartBtn:GetChildren()) do
            if ch:IsA("UIStroke") then
                pcall(function()
                    TweenService:Create(ch, TweenInfo.new(0.15), {Color = C.red, Transparency = 0.4}):Play()
                end)
            end
        end
        StatusDot.BackgroundColor3 = C.green
    else
        pcall(function()
            TweenService:Create(StartBtn, TweenInfo.new(0.15), {BackgroundColor3 = C.accentDk}):Play()
        end)
        StartBtn.Text = "START"
        StartBtn.TextColor3 = C.accent
        for _, ch in ipairs(StartBtn:GetChildren()) do
            if ch:IsA("UIStroke") then
                pcall(function()
                    TweenService:Create(ch, TweenInfo.new(0.15), {Color = C.accent, Transparency = 0.6}):Play()
                end)
            end
        end
        StatusDot.BackgroundColor3 = C.textMut
    end
end

