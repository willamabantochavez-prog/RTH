local function setToggle(btn, on)
    pcall(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = on and C.greenBg or C.surface,
        }):Play()
    end)
    btn.Text = on and "ON" or "OFF"
    btn.TextColor3 = on and C.green or C.red
    for _, ch in ipairs(btn:GetChildren()) do
        if ch:IsA("UIStroke") then
            pcall(function()
                TweenService:Create(ch, TweenInfo.new(0.15), {
                    Color = on and C.green or C.border,
                }):Play()
            end)
        end
    end
end

