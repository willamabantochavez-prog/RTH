local function applyShader(key)
    if not shaders[key] then
        local url = key == "evening" and (SHR .. "evening%2Cjson") or (SHR .. key .. ".json")
        shaders[key] = httpGet(url)
    end
    if not skyboxes[key] then
        local skyKey = key == "midday" and "n" or key == "afternoon" and "a" or "e"
        skyboxes[key] = httpGet(SKY .. skyKey .. ".json")
    end
    light = shaders[key]
    cussky = skyboxes[key]
    shaderEnabled = true
end

local function disableShader()
    shaderEnabled = false
    light = nil
    cussky = nil
    pcall(function() if savedTech then Lighting.Technology = savedTech end end)
    Lighting.Ambient = backup.Ambient
    Lighting.ClockTime = backup.ClockTime
    Lighting.GeographicLatitude = backup.GeographicLatitude
    Lighting.Brightness = backup.Brightness
    Lighting.ColorShift_Bottom = backup.ColorShift_Bottom
    Lighting.ColorShift_Top = backup.ColorShift_Top
    Lighting.EnvironmentDiffuseScale = backup.EnvironmentDiffuseScale
    Lighting.EnvironmentSpecularScale = backup.EnvironmentSpecularScale
    Lighting.GlobalShadows = backup.GlobalShadows
    Lighting.OutdoorAmbient = backup.OutdoorAmbient
    Lighting.ExposureCompensation = backup.ExposureCompensation
    Lighting.FogEnd = backup.FogEnd
    Lighting.FogColor = backup.FogColor
    Lighting.FogStart = backup.FogStart
    Terrain.WaterColor = backup.WaterColor
    Terrain.WaterReflectance = backup.WaterReflectance
    Terrain.WaterTransparency = backup.WaterTransparency
    Terrain.WaterWaveSize = backup.WaterWaveSize
    Terrain.WaterWaveSpeed = backup.WaterWaveSpeed
    sky.SkyboxBk = defaultSky.bk
