--   HTTP + LOADSTRING (original method)
-- ════════════════════════════════

local function httpGet(url)
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if not ok then return nil end
    local ok2, fn = pcall(function() return loadstring(res) end)
    if ok2 and fn then
        local ok3, val = pcall(fn)
        if ok3 then return val end
    end
    local ok4, val = pcall(function()
        return game:GetService("HttpService"):JSONDecode(res)
    end)
    if ok4 then return val end
    return nil
end

