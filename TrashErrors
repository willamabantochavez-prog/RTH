local function selectButton(key)
    local btnData = btnRefs[key]
    if not btnData then return end

    if activeBtn and activeBtn ~= btnData.btn then
        local prev = btnRefs[activeKey]
        if prev then
            tw(prev.btn, {BackgroundColor3 = C.hover, BackgroundTransparency = 0.4}, 0.2)
            tw(prev.lbl, {TextColor3 = C.textDim}, 0.2)
            tw(prev.dot, {BackgroundColor3 = C.accentDim, BackgroundTransparency = 0.5}, 0.2)
        end
    end

    activeBtn = btnData.btn
    activeKey = key
    tw(btnData.btn, {BackgroundColor3 = Color3.fromRGB(25, 20, 8), BackgroundTransparency = 0.15}, 0.2)
    tw(btnData.lbl, {TextColor3 = C.accent}, 0.2)
    tw(btnData.dot, {BackgroundColor3 = C.accent, BackgroundTransparency = 0}, 0.2)

    applyShader(key)

    local names = {midday = "Midday", afternoon = "Afternoon", evening = "Evening"}
    StatusLabel.Text = string.lower(names[key] or key) .. " active"
    StatusLabel.TextColor3 = C.green
end

