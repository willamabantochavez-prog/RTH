                    {TextTransparency = 0, Position = UDim2.new(0, 0, 0, 0)}):Play()
            end)
        end
    end)

    -- "CODE SNIPER" cascade
    task.delay(0.35, function()
        for i, lt in ipairs(line2l) do
            task.delay((i - 1) * 0.02, function()
                lt.Position = UDim2.new(0, 0, -0.3, 0)
                tn(lt, 0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out,
                    {TextTransparency = 0.05, Position = UDim2.new(0, 0, 0, 0)}):Play()
            end)
        end
    end)

    -- Loading ring (0.6s to 2.5s)
    task.delay(0.5, function()
        local duration = 2.0
        local startTime = tick()
        task.spawn(function()
            while gui and gui.Parent and introActive do
                local elapsed = tick() - startTime
                local progress = math.min(elapsed / duration, 1)
                ringArc.Rotation = -90 + progress * 360
                progressText.Text = math.floor(progress * 100) .. "%"
                arcStroke.Transparency = 0.1 + (1 - progress) * 0.5
                if progress >= 1 then break end
                task.wait(0.04)
            end
            progressText.Text = "100%"
            arcStroke.Transparency = 0.1
        end)
    end)

    -- Spark burst at ~2.5s
    task.delay(2.5, function()
        for i = 1, 20 do
            local sparkSize = math.random(5, 12)
            local spark = Instance.new("Frame", gui)
            spark.Size = UDim2.new(0, sparkSize, 0, sparkSize)
            spark.Position = UDim2.new(0.5, 0, 0.80, 0)
            spark.AnchorPoint = Vector2.new(0.5, 0.5)
            spark.BackgroundColor3 = (i % 3 == 0) and Purple3 or White1
            spark.BackgroundTransparency = 0.1
            spark.BorderSizePixel = 0
            spark.Rotation = math.random(0, 360)
            spark.ZIndex = 10
            Instance.new("UICorner", spark).CornerRadius = UDim.new(0, 1)
            
            local dur = 0.2 + math.random() * 0.2
            tn(spark, dur, Enum.EasingStyle.Back, Enum.EasingDirection.Out, {
                Position = UDim2.new(0.5 + (math.random() - 0.5) * 0.6, 0, 0.80 + (math.random() - 0.5) * 0.5, 0),
                BackgroundTransparency = 1,
                Size = UDim2.new(0, 0, 0, 0),
                Rotation = spark.Rotation + math.random(-180, 180)
            }):Play()
            task.delay(dur, function() pcall(function() spark:Destroy() end) end)
        end
        
        local flash = Instance.new("Frame", gui)
        flash.Size = UDim2.new(1, 0, 1, 0)
        flash.BackgroundColor3 = Purple1
        flash.BackgroundTransparency = 0.7
        flash.BorderSizePixel = 0
        flash.ZIndex = 9
        tn(flash, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {BackgroundTransparency = 1}):Play()
        task.delay(0.4, function() pcall(function() flash:Destroy() end) end)
    end)

    -- ============================================================
    -- FADE OUT AT 4.2 SECONDS (total = 5s with cleanup)
    -- ============================================================
    task.delay(4.2, function()
        if not introActive then return end
        
        local ot = 0.5
        for _, lt in ipairs(line1l) do tn(lt, ot, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {TextTransparency = 1}):Play() end
        for _, lt in ipairs(line2l) do tn(lt, ot, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {TextTransparency = 1}):Play() end
        tn(li, ot, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {ImageTransparency = 1}):Play()
        tn(imageStroke, ot, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {Transparency = 1}):Play()
        tn(triBorder, ot, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {BackgroundTransparency = 1}):Play()
        tn(loadingRing, ot, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {BackgroundTransparency = 1}):Play()
        tn(progressText, ot, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {TextTransparency = 1}):Play()
        tn(bgGrad, ot, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {BackgroundTransparency = 1}):Play()
        tn(glowOverlay, ot, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {BackgroundTransparency = 1}):Play()
        tn(skipBtn, ot, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {BackgroundTransparency = 1, TextTransparency = 1}):Play()
        tn(skipStroke, ot, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {Transparency = 1}):Play()
        tn(skipArrow, ot, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {TextTransparency = 1}):Play()
        if introBlur and introBlur.Parent then
            tn(introBlur, ot + 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {Size = 0}):Play()
        end
        for _, p in ipairs(particles) do
            if p.frame then tn(p.frame, ot, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {BackgroundTransparency = 1}):Play() end
        end
        for _, p in ipairs(triangleRain) do
            if p.frame then tn(p.frame, ot, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {BackgroundTransparency = 1}):Play() end
        end
    end)

    -- DESTROY EVERYTHING AT 5 SECONDS
    task.delay(D, function()
        introActive = false
        uf()
        pcall(function() if introSound and introSound.Parent then introSound:Stop(); introSound:Destroy() end end)
        pcall(function() if introBlur and introBlur.Parent then introBlur:Destroy() end end)
        if gui and gui.Parent then gui:Destroy() end
    end)
end

if playIntroEnabled then
    playIntroAnimation()
end
